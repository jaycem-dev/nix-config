binds {
    Mod+Shift+Slash { show-hotkey-overlay; } 
    Mod+Shift+Q { quit; }
    Mod+Tab { focus-workspace-previous; }
    Mod+O { toggle-overview; }
    Mod+Q { close-window; }
    Mod+Shift+V       { toggle-window-floating; }
    Mod+V { switch-focus-between-floating-and-tiling; }
    Mod+Shift+T { toggle-column-tabbed-display; }
    Mod+Shift+S { screenshot-screen; }
    Mod+C { center-column; }
    Mod+Shift+C { center-visible-columns; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+E { expand-column-to-available-width; } 
    Mod+Shift+R {switch-preset-window-height;}
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    // https://niri-wm.github.io/niri/Configuration%3A-Key-Bindings.html#toggle-keyboard-shortcuts-inhibit
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Comma  { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }

    Mod+Left  { focus-column-left; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-or-workspace-down; }
    Mod+Down     { focus-window-or-workspace-down; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+Up     { focus-window-or-workspace-up; }
    Mod+Right { focus-column-right; }
    Mod+L     { focus-column-right; }
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+WheelScrollDown      { focus-window-or-workspace-down; }
    Mod+WheelScrollUp        { focus-window-or-workspace-up; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+Down     { move-window-down-or-to-workspace-down; }
    Mod+Shift+J     { move-window-down-or-to-workspace-down; }
    Mod+Shift+Up     { move-window-up-or-to-workspace-up; }
    Mod+Shift+K     { move-window-up-or-to-workspace-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+L     { move-column-right; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+Shift+0 { reset-window-height; }

    // media keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn "volume" "up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "volume" "down"; }
    XF86AudioMute        allow-when-locked=true { spawn "volume" "mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "volume" "micmute"; }
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn "playerctl" "stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightness" "up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightness" "down"; }
    Ctrl+XF86MonBrightnessUp { spawn "brightness" "up" "2"; }
    Ctrl+XF86MonBrightnessDown { spawn "brightness" "down" "2"; }
    Mod+XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "-q" "-d" "kbd_backlight" "s" "+25%"; }
    Mod+XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "-q" "-d" "kbd_backlight" "s" "25%-"; }

    // application binds
    Mod+D hotkey-overlay-title="Dismiss notification" { spawn "makoctl" "dismiss"; }
    Mod+I hotkey-overlay-title="Invoke notification" { spawn "makoctl" "invoke" ;}
    Mod+Space hotkey-overlay-title="App Launcher" { spawn "fuzzel"; }
    Mod+T hotkey-overlay-title="Terminal" { spawn "spawn-or-focus" "app" "kitty" "-1" "--id" "kitty"; }
    Mod+Slash hotkey-overlay-title="Terminal (Quick access)" { spawn "kitten" "quick-access-terminal"; }
    Mod+G hotkey-overlay-title="Make current window global (pin)" { spawn "nirius" "toggle-follow-mode"; }
    Mod+E hotkey-overlay-title="Yazi" { spawn "spawn-or-focus" "tui" "yazi"; }
    Mod+B hotkey-overlay-title="Browser" { spawn "spawn-or-focus" "app" "brave-origin"; }
    Mod+Shift+B hotkey-overlay-title="Toggle bar" { spawn "pkill"  "-SIGUSR1" "waybar" ; }
    Mod+W hotkey-overlay-title="Whatsapp" { spawn "spawn-or-focus" "webapp" "web.whatsapp.com"; }
    Mod+M hotkey-overlay-title="Spotify" { spawn "spawn-or-focus" "webapp" "open.spotify.com"; }
    Mod+Shift+M hotkey-overlay-title="ProtonMail" { spawn "spawn-or-focus" "webapp" "mail.proton.me"; }
    Mod+Y hotkey-overlay-title="YouTube" { spawn "spawn-or-focus" "webapp" "www.youtube.com"; }
    Mod+P { spawn "dmenu-power"; }
    Mod+N hotkey-overlay-title="Neovim" { spawn "spawn-or-focus" "tui" "projects-picker" "nvim" "--id" "nvim"; }
    Mod+A hotkey-overlay-title="Opencode" { spawn "spawn-or-focus" "tui" "projects-picker" "opencode" "--id" "opencode"; }
    Mod+Shift+N hotkey-overlay-title="Neovim (new instance)" { spawn "kitty" "-1" "--app-id" "nvim" "projects-picker" "nvim"; }
    Mod+Shift+A hotkey-overlay-title="Opencode (new instance)" { spawn "kitty" "-1" "--app-id" "opencode" "projects-picker" "opencode"; }
}
